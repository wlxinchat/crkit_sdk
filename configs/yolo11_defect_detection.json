{
  "model_info": {
    "model_id": "yolo11_defect_detector",
    "model_name": "YOLO11 工业缺陷检测模型",
    "model_path": "models/yolo11n_defect.onnx",
    "version": "1.0.0",
    "description": "基于YOLO11训练的工业质检缺陷检测模型",
    "task_type": "object_detection"
  },

  "engine_config": {
    "engine_type": "onnxruntime",
    "device_type": "cpu",
    "device_id": 0,
    "num_threads": 4,
    "max_batch_size": 1,
    "enable_fp16": false,
    "workspace_size_mb": 1024
  },

  "model_spec": {
    "input_shape": [1, 3, 640, 640],
    "input_format": "NCHW",
    "input_dtype": "float32",
    "input_range": [0.0, 1.0],
    "output_format": "yolo11"
  },

  "preprocessing": {
    "resize": {
      "width": 640,
      "height": 640,
      "keep_aspect_ratio": true,
      "padding_value": 114
    },
    "normalize": {
      "enabled": false,
      "mean": [0.0, 0.0, 0.0],
      "std": [1.0, 1.0, 1.0]
    },
    "color_space": "RGB",
    "data_layout": "CHW"
  },

  "postprocessing": {
    "confidence_threshold": 0.25,
    "nms_threshold": 0.45,
    "max_detections": 300,
    "score_threshold": 0.001
  },

  "classes": {
    "num_classes": 8,
    "class_names": [
      "scratch",
      "dent",
      "crack",
      "discoloration",
      "contamination",
      "burr",
      "bubble",
      "deformation"
    ],
    "class_descriptions": {
      "scratch": "表面划痕缺陷",
      "dent": "表面凹痕缺陷",
      "crack": "表面裂纹缺陷",
      "discoloration": "表面变色缺陷",
      "contamination": "表面污染缺陷",
      "burr": "边缘毛刺缺陷",
      "bubble": "表面气泡缺陷",
      "deformation": "形变缺陷"
    }
  },

  "visualization": {
    "enabled": true,
    "bbox_thickness": 2,
    "font_scale": 0.5,
    "show_confidence": true,
    "show_label": true,
    "class_colors": {
      "scratch": [255, 0, 0],
      "dent": [0, 255, 0],
      "crack": [0, 0, 255],
      "discoloration": [255, 255, 0],
      "contamination": [255, 0, 255],
      "burr": [0, 255, 255],
      "bubble": [128, 128, 0],
      "deformation": [128, 0, 128]
    }
  },

  "performance": {
    "warmup_iterations": 10,
    "enable_profiling": false,
    "log_level": "INFO"
  },

  "quality_control": {
    "defect_severity": {
      "high": {
        "min_confidence": 0.8,
        "action": "reject"
      },
      "medium": {
        "min_confidence": 0.5,
        "action": "review"
      },
      "low": {
        "min_confidence": 0.25,
        "action": "monitor"
      }
    },
    "alert_thresholds": {
      "max_defects_per_item": 5,
      "critical_defect_types": ["crack", "deformation"]
    }
  }
}
